{
  "name": "@snct-sportease/matchline",
  "version": "1.1.0",
  "description": "Zero-dependency Vanilla TypeScript tournament bracket renderer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/snct-SportEase/matchline.git"
  },
  "homepage": "https://github.com/snct-SportEase/matchline#readme",
  "bugs": {
    "url": "https://github.com/snct-SportEase/matchline/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "dev": "vite demo",
    "demo:build": "vite build demo",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "keywords": [
    "tournament",
    "bracket",
    "single-elimination",
    "typescript",
    "zero-dependency",
    "svg"
  ],
  "license": "MIT",
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.8.0",
    "vite": "^6.2.0"
  }
}
